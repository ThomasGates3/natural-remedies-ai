# Gemini API key — used ONLY by the server-side function at /api/remedies.ts.
# It is never exposed to the browser bundle (note: NO VITE_ prefix).
# Get a key: https://aistudio.google.com/app/apikey
# Local live testing: put the real value in .env.local (gitignored) and run `vercel dev`.
# Production: set this in your host's secret store (Vercel Project Env Vars, AWS Secrets Manager, etc.).
# Either name works; GEMINI_API_KEY takes precedence.
GEMINI_API_KEY=your-api-key-here
# GOOGLE_API_KEY=your-api-key-here

# Without a key the app gracefully shows clearly-labeled EXAMPLE remedies instead of erroring.

# Base URL of the backend API (browser-visible, hence the VITE_ prefix — safe, it's just a URL).
# Leave empty for same-origin (Vercel). On GCP set it to the Cloud Run service URL so the
# bucket-hosted frontend can reach the API on its separate domain. The deploy workflow injects
# this automatically at build time; only set it here for local builds against a remote API.
# VITE_API_ENDPOINT=https://natural-remedies-ai-api-dev-xxxxxxxxxx-ue.a.run.app
